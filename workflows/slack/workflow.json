        "jsCode": "const slackResult = $input.first() ? $input.first().json : {};\nreturn [{\n  json: {\n    success: true,\n    channel: slackResult.channel || $(\"Prepare Outbound Message\").first().json.channel,\n    ts: slackResult.ts || \"\",\n    message: slackResult.message || $(\"Prepare Outbound Message\").first().json.text,\n    deliveredAt: new Date().toISOString()\n  }\n}];"
