    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst event = body.event || body;\n\nconst rawText = (event.text || \"\").trim();\nconst cleanedText = rawText.replace(/<@[A-Z0-9]+>/g, \"\").trim().toLowerCase();\n\nconst cancelRegex = /^(stop|cancel|\\/stop|\\/cancel|abort|\\/abort)$/i;\nconst isCancel = cancelRegex.test(cleanedText);\n\nreturn [{\n  json: {\n    event: {\n      type: event.type || \"message\",\n      channel: event.channel || \"\",\n      user: event.user || \"\",\n      text: rawText,\n      cleanedText,\n      ts: event.ts || \"\",\n      thread_ts: event.thread_ts || event.ts || \"\"\n    },\n    isCancel,\n    rawEvent: event,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
