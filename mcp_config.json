{
  "mcpServers": {
    "meshnet-n8n": {
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "local-n8n",
        "--config",
        "prd",
        "--",
        "npx",
        "-y",
        "n8n-mcp"
      ],
      "env": {
        "N8N_HOST": "https://n8n.local-n8n.com",
        "N8N_API_KEY": "YOUR_N8N_API_KEY_HERE",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    }
  }
}
