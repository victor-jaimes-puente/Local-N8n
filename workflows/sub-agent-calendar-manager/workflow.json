    {
      "parameters": {
        "jsCode": "const inputNode = $('Prepare Sub-Agent Input');\nconst query = (inputNode && inputNode.isExecuted) ? inputNode.first().json.query : ($json.query || '');\nconst agentOutput = $json.output || $json.text || $json;\n\nreturn [{\n  json: {\n    status: \"success\",\n    query: query,\n    response: typeof agentOutput === 'string' ? agentOutput : JSON.stringify(agentOutput),\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
