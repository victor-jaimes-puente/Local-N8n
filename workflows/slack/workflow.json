    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst event = body.event || {};\n\n// Ignore bot messages to avoid echo loops\nif (event.bot_id || event.subtype === \"bot_message\") {\n  return [];\n}\n\nreturn [{\n  json: {\n    eventType: event.type || \"message\",\n    channel: event.channel || \"\",\n    user: event.user || \"\",\n    text: event.text || \"\",\n    ts: event.ts || \"\",\n    thread_ts: event.thread_ts || event.ts || \"\",\n    rawEvent: event,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "slack-parse-inbound",
      "name": "Parse Inbound Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        304
      ]
    },
