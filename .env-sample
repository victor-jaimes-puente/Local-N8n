# ==============================================================================
# DOPPLER SECRETS SCHEMA REFERENCE (PHASE 2)
# ==============================================================================
# WARNING: A local .env file is no longer used for this deployment. 
# All variables below must be managed and injected securely via Doppler at runtime.
# Example: doppler run -- docker compose up -d
# ==============================================================================

# Ingress & Routing
DOMAIN_NAME=local-n8n.com
SUBDOMAIN=n8n

# Queue & Runtime Settings
GENERIC_TIMEZONE=America/Chicago
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=redis
QUEUE_HEALTH_CHECK_ACTIVE=true
NODE_ENV=production

# Application Security
N8N_ENCRYPTION_KEY=your_high_entropy_32_character_string_here

# PostgreSQL Credentials
POSTGRES_USER=n8nRootUser
POSTGRES_PASSWORD=your_secure_root_password_here
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8nRootUser
POSTGRES_NON_ROOT_PASSWORD=your_secure_non_root_password_here
