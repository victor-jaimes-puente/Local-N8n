{
  "id": "Pl3LHiJp4nbF7zz2",
  "name": "deliver-reminder",
  "active": true,
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "deliver-reminder",
        "responseMode": "lastNode"
      },
      "position": [100, 300],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "deliver-reminder-webhook"
    },
    {
      "id": "parse-payload",
      "name": "Validate & Parse Payload",
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst reminder_id = body.reminder_id || body.id;\nconst task = body.task || 'Reminder';\nconst slack_channel = body.slack_channel || '';\nconst offset_label = body.offset_label || 'event time';\nconst target_time = body.target_time || '';\n\nif (!reminder_id) {\n  throw new Error('Missing reminder_id in payload: ' + JSON.stringify(body));\n}\n\nreturn [{\n  json: {\n    reminder_id: Number(reminder_id),\n    task,\n    slack_channel,\n    offset_label,\n    target_time,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "position": [300, 300],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "get-row",
      "name": "Get Reminder Row",
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "UfEmiO0qytgmsjE4"
        },
        "filters": {
          "conditions": [
            {
              "condition": "eq",
              "keyName": "id",
              "keyValue": "={{ $json.reminder_id }}"
            }
          ]
        },
        "operation": "get"
      },
      "position": [500, 300],
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1
    },
    {
      "id": "check-status",
      "name": "Check Status Pending",
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond-is-pending",
              "leftValue": "={{ $json.status }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "pending"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [700, 300],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "id": "lock-processing",
      "name": "Lock Row (Processing)",
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "processing"
          }
        },
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "UfEmiO0qytgmsjE4"
        },
        "filters": {
          "conditions": [
            {
              "condition": "eq",
              "keyName": "id",
              "keyValue": "={{ $('Validate & Parse Payload').item.json.reminder_id }}"
            }
          ]
        },
        "operation": "update"
      },
      "position": [900, 200],
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1
    },
    {
      "credentials": {
        "slackApi": {
          "id": "VzU1fxGd9Yg0Y3hM",
          "name": "TiranoTech - Tirano"
        }
      },
      "id": "slack-alert",
      "name": "Slack Notification",
      "parameters": {
        "authentication": "accessToken",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Validate & Parse Payload').item.json.slack_channel }}"
        },
        "operation": "post",
        "resource": "message",
        "select": "channel",
        "text": "=⏰ *Reminder:* {{ $('Validate & Parse Payload').item.json.task }} (_{{ $('Validate & Parse Payload').item.json.offset_label }}_)"
      },
      "position": [1100, 200],
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "webhookId": "deliver-reminder-slack"
    },
    {
      "id": "mark-completed",
      "name": "Mark Completed",
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "completed"
          }
        },
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "UfEmiO0qytgmsjE4"
        },
        "filters": {
          "conditions": [
            {
              "condition": "eq",
              "keyName": "id",
              "keyValue": "={{ $('Validate & Parse Payload').item.json.reminder_id }}"
            }
          ]
        },
        "operation": "update"
      },
      "position": [1300, 200],
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1
    },
    {
      "id": "skipped-resp",
      "name": "Skipped Response",
      "parameters": {
        "jsCode": "const row = $input.first().json;\nreturn [{\n  json: {\n    success: true,\n    skipped: true,\n    current_status: row.status,\n    message: `Reminder ${row.id} skipped (status is ${row.status})`\n  }\n}];"
      },
      "position": [900, 400],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    }
  ],
