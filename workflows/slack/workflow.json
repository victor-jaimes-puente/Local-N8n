    {
      "id": "slack-cancel-executions",
      "name": "Cancel Active Executions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        160
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst event = item.event || {};\nconst targetThread = event.thread_ts || event.ts || \"\";\nconst targetChannel = event.channel || \"\";\n\nconst N8N_API_KEY = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI1NGQ4MTcxOC0xZjVkLTQxNTQtYWMxOC0xMzc2NTk1MzVmZGIiLCJpc3MiOiJuOG4iLCJhdWQiOiJwdWJsaWMtYXBpIiwianRpIjoiMmIzZDdjMDMtODZlNi00MGYwLTlhOWMtZjZiYjM2NGI4NzhlIiwiaWF0IjoxNzg4MjE1NzUxfQ.aT_eCBS-0dPfsPLO97o1kJIhXVTIHVpn418gGIx_9LU\";\nconst N8N_API_URL = \"http://n8n:5678/api/v1\";\n\nlet stoppedCount = 0;\nlet details = [];\n\ntry {\n  const listRes = await this.helpers.httpRequest({\n    method: \"GET\",\n    url: `${N8N_API_URL}/executions?status=running&workflowId=Fq6gdZ5X10eOiCQA&includeData=true&limit=10`,\n    headers: {\n      \"X-N8N-API-KEY\": N8N_API_KEY,\n      \"Accept\": \"application/json\"\n    },\n    json: true\n  });\n\n  const runningList = (listRes && listRes.data) ? listRes.data : [];\n\n  for (const exec of runningList) {\n    const trigData = exec.data?.resultData?.runData?.[\"When Executed by Another Workflow\"]?.[0]?.data?.main?.[0]?.[0]?.json?.event;\n    const execThread = trigData?.thread_ts || trigData?.ts || \"\";\n    const execChannel = trigData?.channel || \"\";\n\n    const isMatch = (targetThread && (execThread === targetThread || trigData?.ts === targetThread)) ||\n                    (targetChannel && execChannel === targetChannel);\n\n    if (isMatch || runningList.length === 1) {\n      try {\n        await this.helpers.httpRequest({\n          method: \"POST\",\n          url: `${N8N_API_URL}/executions/${exec.id}/stop`,\n          headers: {\n            \"X-N8N-API-KEY\": N8N_API_KEY,\n            \"Accept\": \"application/json\"\n          },\n          json: true\n        });\n        stoppedCount++;\n        details.push(`Stopped execution ${exec.id}`);\n      } catch (stopErr) {\n        details.push(`Failed to stop ${exec.id}: ${stopErr.message}`);\n      }\n    }\n  }\n\n  if (stoppedCount === 0 && runningList.length > 0) {\n    try {\n      const stopManyRes = await this.helpers.httpRequest({\n        method: \"POST\",\n        url: `${N8N_API_URL}/executions/stop`,\n        headers: {\n          \"X-N8N-API-KEY\": N8N_API_KEY,\n          \"Content-Type\": \"application/json\",\n          \"Accept\": \"application/json\"\n        },\n        body: {\n          status: [\"running\"],\n          workflowId: \"Fq6gdZ5X10eOiCQA\"\n        },\n        json: true\n      });\n      stoppedCount += (stopManyRes && stopManyRes.stopped) ? stopManyRes.stopped : 0;\n    } catch (e) {}\n  }\n} catch (err) {\n  details.push(`Error querying executions: ${err.message}`);\n}\n\nconst cancelMessage = stoppedCount > 0 \n  ? \"🛑 Request cancelled.\" \n  : \"ℹ️ No active request found to cancel.\";\n\nreturn [{\n  json: {\n    event,\n    channel: targetChannel,\n    thread_ts: targetThread,\n    stoppedCount,\n    details,\n    cancelMessage,\n    timestamp: new Date().toISOString()\n  }\n}];"
      }
    },
