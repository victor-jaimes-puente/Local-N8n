  "triggerCount": 0,
  "nodes": [
    {
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "normalize",
      "name": "Normalize Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet raw = input.reminders ?? input.query ?? input.input ?? input;\nif (typeof raw === 'string') {\n  try { raw = JSON.parse(raw); } catch(e) {}\n}\nlet reminders = [];\nif (Array.isArray(raw)) {\n  reminders = raw;\n} else if (raw && typeof raw === 'object' && Array.isArray(raw.reminders)) {\n  reminders = raw.reminders;\n} else if (raw && typeof raw === 'object' && raw.task) {\n  reminders = [raw];\n}\n\nif (reminders.length === 0) {\n  throw new Error(\"No reminders provided in input: \" + JSON.stringify(input));\n}\n\nreturn reminders.map(r => ({\n  json: {\n    task: r.task || '',\n    target_time: r.target_time || '',\n    notify_time: r.notify_time || '',\n    offset_label: r.offset_label || 'event time',\n    status: r.status || 'pending',\n    slack_channel: r.slack_channel || ''\n  }\n}));"
      }
    },
    {
      "id": "insert-rows",
      "name": "Insert Into Reminders Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "notify_time": "={{ $json.notify_time }}",
            "offset_label": "={{ $json.offset_label }}",
            "slack_channel": "={{ $json.slack_channel }}",
            "status": "={{ $json.status }}",
            "target_time": "={{ $json.target_time }}",
            "task": "={{ $json.task }}"
          }
        },
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "UfEmiO0qytgmsjE4"
        },
        "operation": "insert"
      }
    },
    {
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn [{\n  json: {\n    success: true,\n    inserted_count: items.length,\n    reminders: items.map(i => i.json)\n  }\n}];"
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
