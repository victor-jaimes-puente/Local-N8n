    {
      "parameters": {
        "jsCode": "const inputData = $input.first() ? $input.first().json : {};\n\nconst channel = inputData.channel || inputData.channelId || \"general\";\nconst text = inputData.text || inputData.message || \"Hello from n8n Slack Integration!\";\nconst thread_ts = inputData.thread_ts || inputData.threadTs || \"\";\n\nreturn [{\n  json: {\n    channel,\n    text,\n    thread_ts,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
