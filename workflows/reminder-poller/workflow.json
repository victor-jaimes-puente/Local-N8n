      "typeVersion": 1.1
    },
    {
      "id": "manual-trigger",
      "name": "Execute Workflow Trigger",
      "parameters": {
        "inputSource": "passthrough"
      },
      "position": [100, 150],
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1
    },
    {
      "id": "sweep-zombies",
      "name": "Get Zombie Processing Rows",
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "UfEmiO0qytgmsjE4"
        },
        "filters": {
          "conditions": [
            {
              "condition": "eq",
              "keyName": "status",
              "keyValue": "processing"
            }
          ]
        },
        "matchType": "allConditions",
        "operation": "get",
        "returnAll": true
      },
      "position": [300, 150],
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1
    },
    {
      "id": "filter-stale",
      "name": "Filter Stale (>5m)",
      "parameters": {
        "jsCode": "const items = $input.all();\nconst cutoff = Date.now() - (5 * 60 * 1000);\nconst stale = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const updatedTime = row.updatedAt ? new Date(row.updatedAt).getTime() : 0;\n  if (updatedTime < cutoff && row.id) {\n    stale.push({ json: row });\n  }\n}\n\nreturn stale;"
      },
      "position": [500, 150],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "reset-stale",
      "name": "Reset Stale to Pending",
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "pending"
          }
        },
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "UfEmiO0qytgmsjE4"
        },
        "filters": {
          "conditions": [
            {
              "condition": "eq",
              "keyName": "id",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "operation": "update"
      },
      "position": [700, 150],
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1
    },
    {
      "id": "get-due",
      "name": "Get Due Reminders",
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "UfEmiO0qytgmsjE4"
        },
        "filters": {
          "conditions": [
            {
              "condition": "eq",
              "keyName": "status",
              "keyValue": "pending"
            },
            {
              "condition": "lte",
              "keyName": "notify_time",
              "keyValue": "={{ $now.toISO() }}"
            }
          ]
        },
        "matchType": "allConditions",
        "operation": "get",
        "returnAll": true
      },
      "position": [300, 350],
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1
    },
    {
