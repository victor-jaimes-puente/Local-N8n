      "parameters": {
        "toolDescription": "Insert a reminder row into the reminders table. Requires task, target_time, notify_time, offset_label, status='pending', and slack_channel.",
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "SYBlBNK8FaTVTDdc"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "task": "={{ $fromAI('task', 'task or event description') }}",
            "target_time": "={{ $fromAI('target_time', 'ISO 8601 timestamp of the actual event') }}",
            "notify_time": "={{ $fromAI('notify_time', 'ISO 8601 timestamp for when to alert') }}",
            "offset_label": "={{ $fromAI('offset_label', 'timing offset label such as 1 week before or 10 minutes before') }}",
            "status": "={{ $fromAI('status', 'reminder status, default pending', 'string', 'pending') }}",
            "slack_channel": "={{ $fromAI('slack_channel', 'target slack channel', 'string', $('Prepare Sub-Agent Input').item.json.slack_channel) }}"
          },
          "schema": [
            {
              "id": "task",
              "displayName": "task",
