    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst event = body.event || body;\n\nreturn [{\n  json: {\n    event: {\n      type: event.type || \"message\",\n      channel: event.channel || \"\",\n      user: event.user || \"\",\n      text: event.text || \"\",\n      ts: event.ts || \"\",\n      thread_ts: event.thread_ts || event.ts || \"\"\n    },\n    rawEvent: event,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
